{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Helper",
  "version": "1.1.1",
  "identifier": "com.meetinghelper.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Helper",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundThrottling": "disabled",
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["meeting-helper"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNzUyODZDRTczNzA5MjIKUldRaUNUZm5iQ2gxTHdsWHU0eVV1RWZwSnFXSGt0UTVudmJqSTBKQnNMdXFpTUNYZW5NYkdXWjQK",
      "endpoints": ["https://github.com/Azmekk/meeting-helper/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "The live overlay window: display-only, talks to main through events",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
